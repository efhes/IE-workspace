{
  "timeout_seconds": 15,
  "sensehat": {
    "enabled": true,
    "rotation": 180,
    "low_light": true,
    "hold_to_stop_seconds": 3
  },
  "modes": [
    {
      "name": "Image Recognition (GUI)",
      "type": "gui",
      "workdir": "~/workspace/image_recognition/",
      "venv": "~/venvml",
      "command": "python src/demo-gui.py"
    },
    {
      "name": "Image Recognition (CLI)",
      "type": "cli",
      "workdir": "~/workspace/image_recognition/src",
      "venv": "~/venvml",
      "command": "python demo.py"
    },
    {
      "name": "HAR Inertial LSTM (CLI)",
      "type": "cli",
      "workdir": "~/workspace/HAR_INERCIAL_v2/",
      "venv": "~/venvml",
      "command": "python src/demo-lstm-recognizer.py"
    },
    {
      "name": "FER MediaPipe (GUI)",
      "type": "gui",
      "workdir": "~/workspace/",
      "venv": "~/venvml",
      "command": "python FER_mediapipe/src/run_demo.py"
    },
    {
      "name": "HAR MediaPipe (GUI)",
      "type": "gui",
      "workdir": "~/workspace/",
      "venv": "~/venvml",
      "command": "python HAR_mediapipe/src/demo-custom-dataset.py"
    }
  ]
}